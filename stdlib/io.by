import std.stack;
import std.str;
import std.u8;
import std.cfg;
#[target = "interpreter"]
import std.os.interpreter;
#[target = "z80-unknown-cpm"]
import std.os.cpm;

module std.io;

def print(std.str.Str -- )
    0u8
    | std.str.Str, u8 -- std.str.Str, u8, bool | {
        std.stack.over                              // Str u8 Str
        std.str.len                                 // Str u8 u8
        std.stack.over                              // Str u8 u8 u8
        std.stack.swap                              // Str u8 u8 u8
        std.u8.lt
    }
    | std.str.Str, u8 -- std.str.Str, u8 | {
        std.stack.over std.stack.over               // Str u8 Str u8
        std.str.get                                 // Str u8 u8
        _put_char                                   // Str u8

        1u8 std.u8.add
    }
    std.cfg.while
    std.stack.drop std.stack.drop
end

def println(std.str.Str -- )
    print

    "\n" print
end

def input( -- u8)
    _read_char
end

/// interpreter specific

#[target = "interpreter"]
def _put_char(u8 -- )
    std.os.interpreter.put_char
end

#[target = "interpreter"]
def _read_char( -- u8)
    std.os.interpreter.read_char
end

/// Z80 CP/M specific

#[target = "z80-unknown-cpm"]
def _put_char(u8 -- )
    std.os.cpm.c_write
end

#[target = "z80-unknown-cpm"]
def _read_char( -- u8)
    std.os.cpm.c_read
end
