import std.intrinsics;

module std.usize;

#[target = "interpreter"]
#[target = "z80-unknown-cpm"]
def from_u8(u8 -- usize) std.intrinsics.u8_to_usize end

#[target = "interpreter"]
#[target = "z80-unknown-cpm"]
def from_u16(u16 -- usize) std.intrinsics.u16_to_usize end

#[target = "interpreter"]
#[target = "z80-unknown-cpm"]
def low_u8(usize -- u8) std.intrinsics.usize_to_u8 end

#[target = "interpreter"]
#[target = "z80-unknown-cpm"]
def low_u16(usize -- u16) std.intrinsics.usize_to_u16 end

def add(usize, usize -- usize) std.intrinsics.add end

def sub(usize, usize -- usize) std.intrinsics.sub end

def mul(usize, usize -- usize) std.intrinsics.mul end

def div(usize, usize -- usize) std.intrinsics.div end

def eq(usize, usize -- bool) std.intrinsics.eq end

def gt(usize, usize -- bool) std.intrinsics.gt end

def lt(usize, usize -- bool) std.intrinsics.lt end
