import std.intrinsics;

module std.stack;

// Drop the top element from the stack.
def drop<T>(T --) std.intrinsics.drop end

// Duplicate the top element on the stack.
def dup<T>(T -- T, T) std.intrinsics.dup end

// Swap the top two elements on the stack.
def swap<A, B>(A, B -- B, A) std.intrinsics.swap end

// Duplicate the second element from the top of the stack.
def over<A, B>(A, B -- A, B, A) std.intrinsics.over end

// Call a function with the given arguments.
def call<...S, ...R>(
    ...S,
    |...S -- ...R| // body
    --
    ...R
) std.intrinsics.call end
