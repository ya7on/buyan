import std.intrinsics;

module std.u8;

def add(u8, u8 -- u8) std.intrinsics.add end

def sub(u8, u8 -- u8) std.intrinsics.sub end

def mul(u8, u8 -- u8) std.intrinsics.mul end

def div(u8, u8 -- u8) std.intrinsics.div end

def eq(u8, u8 -- bool) std.intrinsics.eq end

def gt(u8, u8 -- bool) std.intrinsics.gt end

def lt(u8, u8 -- bool) std.intrinsics.lt end
