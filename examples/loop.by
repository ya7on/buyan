import std.cfg;
import std.io;
import std.math;
import std.stack;

module example_loop;

def main( -- u8 )
    0u8
    0u8
    | u8 -- u8, bool | { std.stack.dup 5u8 std.math.lt }
    | u8 -- u8 | { 1u8 std.math.add "iter" std.io.println }
    std.cfg.while
    std.stack.drop
    "after loop" std.io.println
end
